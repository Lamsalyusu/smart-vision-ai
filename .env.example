# ===================================================
# Smart Vision AI - Environment Configuration Template
# ===================================================

# Application Environment (development | production | test)
NODE_ENV=development
AUTH_API_URL=http://localhost:8000
VISION_API_URL=

# Security - generate each value with: openssl rand -hex 32
SECRET_KEY=
# Required. Shared by the Next.js server, the FastAPI service and the vision
# service. FastAPI rejects every non-health request without it, so login,
# signup, telemetry and replay all fail with 503 when it is unset.
INTERNAL_API_TOKEN=
# Signs outbound webhooks (X-SmartVision-Signature). Optional in development.
WEBHOOK_SECRET=
RTSP_ALLOWED_HOSTS=
RTSP_MAX_STREAMS=50
RTSP_RECONNECT_DELAY_SECONDS=1.0

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=smart_vision_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# External AI Services & Model APIs (Optional)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Storage & Remote DB (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Mailer (needed for password reset emails from the FastAPI service and the Django UI)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
# Public URL of the web app, used in password reset links
APP_BASE_URL=http://localhost:3000
