# ===================================================
# Smart Vision AI - Environment Configuration Template
# ===================================================

# Application Environment (development | production | test)
NODE_ENV=development
AUTH_API_URL=http://localhost:8000
VISION_API_URL=

# Security - 64-hex char cryptographic secret key (generate using: openssl rand -hex 32)
SECRET_KEY=

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=smart_vision_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Cache / Message Broker (For horizontal scaling and distributed sessions)
REDIS_URL=redis://localhost:6379/0

# External AI Services & Model APIs (Optional)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Storage & Remote DB (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Mailer Configuration (Optional)
EMAIL_HOST_USER=dev@smartvision.local
EMAIL_HOST_PASSWORD=dev-local-password
