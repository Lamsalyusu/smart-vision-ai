{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.smartvision.ai/schemas/events/drift_detected_v6.json",
  "title": "TelemetryEvent_drift_detected_v6",
  "description": "Wasserstein distance concept drift alert triggering auto-retraining (Revision 6)",
  "type": "object",
  "required": [
    "event_id",
    "timestamp_ns",
    "sensor_id",
    "severity",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0
    },
    "sensor_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "severity": {
      "type": "string",
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "CRITICAL"
      ]
    },
    "node_hostname": {
      "type": "string"
    },
    "pipeline_version": {
      "type": "string",
      "enum": [
        "2.4.0",
        "2.4.1",
        "2.5.0-rc1"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "object_id": {
          "type": "integer"
        },
        "class_name": {
          "type": "string"
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "world_coordinates": {
          "type": "object",
          "properties": {
            "x_meters": {
              "type": "number"
            },
            "y_meters": {
              "type": "number"
            },
            "z_meters": {
              "type": "number"
            },
            "uncertainty_std": {
              "type": "number",
              "minimum": 0.0
            }
          },
          "required": [
            "x_meters",
            "y_meters",
            "z_meters"
          ]
        },
        "kinematics": {
          "type": "object",
          "properties": {
            "speed_mps": {
              "type": "number",
              "minimum": 0.0
            },
            "heading_degrees": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 360.0
            },
            "acceleration_mps2": {
              "type": "number"
            }
          }
        },
        "diagnostics": {
          "type": "object",
          "properties": {
            "inference_time_ms": {
              "type": "number"
            },
            "pipeline_latency_ms": {
              "type": "number"
            },
            "buffer_fill_ratio": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        }
      },
      "required": [
        "class_name"
      ]
    }
  }
}
